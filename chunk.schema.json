{
    "$schema": "http://json-schema.org/draft-07/schema",
    "title": "隔絶輪廻のブレインダイバーのチャンクスキーマ",
    "version": "3.0.0",
    "description": "隔絶輪廻のブレインダイバーのチャンクのデータ構造を定義します。",
    "type": "object",
    "patternProperties": {
        "^[a-z0-9_]+$": {
            "type": "object",
            "description": "チャンクの名前\nhubタイプ下に置かれてるものは\"_[hub名]_[アクセスレベル]\"という命名規則とする",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "見出しに使われる名称"
                },
                "type": {
                    "type": "string",
                    "description": "データ構造の種類",
                    "enum": [
                        "hand_out",
                        "hub",
                        "table",
                        "document",
                        "judge",
                        "weapon",
                        "armor",
                        "energy_tank",
                        "consumable",
                        "skill",
                        "enemy"
                    ],
                    "$comment": "必要次第で追加する"
                },
                "priority": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 100,
                    "description": "データベース化の際の優先度\n-1: AIは無視するドキュメント専用のチャンク。\n0-100: 優先度高い順にソートされデータベースとして活用される。値が大きいほど優先度高い。"
                },
                "access_level": {
                    "$ref": "#/definitions/AccessLevel"
                },
                "includes": {
                    "type": "array",
                    "description": "文書化の際に下階層に含めるチャンクのキー\n配列の順番に、下階層に含める順番になります。",
                    "items": {
                        "type": "string",
                        "description": "対象チャンクのキー",
                        "pattern": "^[a-z0-9_]+$"
                    },
                    "uniqueItems": true,
                    "default": []
                },
                "genre": {
                    "type": "array",
                    "description": "ジャンル",
                    "items": {
                        "type": "string",
                        "enum": [
                            "hand_out",
                            "protocol",
                            "level_7",
                            "table",
                            "system",
                            "rule",
                            "document",
                            "judge",
                            "hacking",
                            "energy",
                            "combat",
                            "character",
                            "status",
                            "skill",
                            "enhancement",
                            "weapon",
                            "melee",
                            "range",
                            "armor",
                            "energy_tank",
                            "consumable",
                            "campain",
                            "session",
                            "market",
                            "glossary",
                            "secret",
                            "enemy"
                        ],
                        "uniqueItems": true,
                        "additionalItems": false,
                        "$comment": "必要次第で追加する"
                    }
                },
                "value": {
                    "description": "内容\ntypeに応じて型が変化します。"
                },
                "_comment": {
                    "description": "開発用コメント",
                    "default": ""
                }
            },
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "hand_out"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/HandOutValue"
                            }
                        },
                        "required": [
                            "name",
                            "type",
                            "priority",
                            "access_level",
                            "includes",
                            "genre",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "hub"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/HubValue"
                            }
                        },
                        "required": [
                            "type",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "table"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/TableValue"
                            }
                        },
                        "required": [
                            "name",
                            "type",
                            "priority",
                            "access_level",
                            "includes",
                            "genre",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "document"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/DocumentValue"
                            }
                        },
                        "required": [
                            "name",
                            "type",
                            "priority",
                            "access_level",
                            "includes",
                            "genre",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "judge"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/JudgeValue"
                            }
                        },
                        "required": [
                            "name",
                            "type",
                            "priority",
                            "access_level",
                            "includes",
                            "genre",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "weapon"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/WeaponValue"
                            }
                        },
                        "required": [
                            "name",
                            "type",
                            "priority",
                            "access_level",
                            "includes",
                            "genre",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "armor"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/ArmorValue"
                            }
                        },
                        "required": [
                            "name",
                            "type",
                            "priority",
                            "access_level",
                            "includes",
                            "genre",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "energy_tank"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/EnergyTankValue"
                            }
                        },
                        "required": [
                            "name",
                            "type",
                            "priority",
                            "access_level",
                            "includes",
                            "genre",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "consumable"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/ConsumableValue"
                            }
                        },
                        "required": [
                            "name",
                            "type",
                            "priority",
                            "access_level",
                            "includes",
                            "genre",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "skill"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/SkillValue"
                            }
                        },
                        "required": [
                            "name",
                            "type",
                            "priority",
                            "access_level",
                            "includes",
                            "genre",
                            "value"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "enemy"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/EnemyValue"
                            }
                        },
                        "required": [
                            "name",
                            "type",
                            "priority",
                            "access_level",
                            "includes",
                            "genre",
                            "value"
                        ]
                    }
                }
            ]
        }
    },
    "definitions": {
        "AccessLevel": {
            "type": "number",
            "minimum": -1,
            "maximum": 9,
            "description": "アクセスするのに必要なレベル\n-1: 開発用, 0: 全員, 1-5: ゲーム内レベル1-5, 6: ゲーム内特殊レベル, 1-7: GM向け, 8: シナリオ作成者向け, 9: AI用"
        },
        "ItemInterface": {
            "type": "object",
            "properties": {
                "worth": {
                    "type": "number",
                    "minimum": 0,
                    "description": "価値"
                },
                "flavor": {
                    "type": "string",
                    "description": "アイテムの説明"
                }
            },
            "required": [
                "worth",
                "flavor"
            ]
        },
        "HandOutValue": {
            "type": "object",
            "properties": {
                "access_filter": {
                    "type": "array",
                    "items": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 9,
                        "minItems": 1,
                        "maxItems": 2,
                        "description": "アクセスするのに必要なレベル"
                    }
                },
                "document": {
                    "type": "string",
                    "description": "説明文"
                }
            },
            "required": [
                "access_filter"
            ]
        },
        "HubValue": {
            "type": "array",
            "items": {
                "type": "number",
                "description": "アクセスレベル",
                "minimum": -1,
                "maximum": 9
            },
            "minItems": 2,
            "maxItems": 10,
            "uniqueItems": true
        },
        "TableValue": {
            "type": "object",
            "description": "表",
            "additionalProperties": false,
            "properties": {
                "table": {
                    "type": "array",
                    "description": "行",
                    "items": {
                        "type": "array",
                        "description": "列",
                        "items": {
                            "type": "string",
                            "description": "セル"
                        }
                    }
                },
                "header": {
                    "type": "boolean",
                    "description": "ヘッダーがあるかどうか",
                    "default": false
                }
            },
            "required": [
                "table"
            ]
        },
        "DocumentValue": {
            "type": "array",
            "description": "文章",
            "items": {
                "type": "string",
                "description": "段落"
            }
        },
        "JudgeValue": {
            "type": "object",
            "description": "判定の詳細",
            "additionalProperties": false,
            "properties": {
                "status": {
                    "type": "string",
                    "pattern": "[(HAC|STR|DEX|INT|CHA|LUK|提案)]",
                    "description": "参照されるステータス"
                },
                "skill": {
                    "type": "string",
                    "description": "参照されるスキル"
                },
                "adjustment": {
                    "type": "string",
                    "description": "修正値"
                },
                "formula": {
                    "type": "string",
                    "description": "計算式"
                },
                "description": {
                    "type": "string",
                    "description": "説明"
                }
            },
            "required": [
                "status",
                "skill",
                "adjustment",
                "formula"
            ]
        },
        "WeaponValue": {
            "allOf": [
                {
                    "$ref": "#/definitions/ItemInterface"
                },
                {
                    "type": "object",
                    "properties": {
                        "class": {
                            "type": "string",
                            "description": "武器の種類\n軽量・標準・重量と近接・遠距離の組み合わせの文字列\n例：軽量近接武器",
                            "pattern": "^(軽量|標準|重量)(近接|遠距離)武器$"
                        },
                        "atk": {
                            "type": "number",
                            "minimum": 1,
                            "description": "攻撃力"
                        },
                        "requires": {
                            "type": "object",
                            "patternProperties": {
                                "(HAC|STR|DEX|INT|CHA)": {
                                    "type": "number",
                                    "minimum": 1,
                                    "description": "必要量"
                                }
                            },
                            "additionalProperties": false,
                            "uniqueItems": true
                        }
                    },
                    "required": [
                        "class",
                        "atk"
                    ]
                }
            ]
        },
        "ArmorValue": {
            "allOf": [
                {
                    "$ref": "#/definitions/ItemInterface"
                },
                {
                    "type": "object",
                    "properties": {
                        "dr": {
                            "type": "number",
                            "minimum": 1,
                            "description": "ダメージ減衰能力"
                        },
                        "requires": {
                            "type": "object",
                            "patternProperties": {
                                "(HAC|STR|DEX|INT|CHA)": {
                                    "type": "number",
                                    "minimum": 1,
                                    "description": "必要量"
                                }
                            },
                            "additionalProperties": false,
                            "uniqueItems": true
                        }
                    },
                    "required": [
                        "dr"
                    ]
                }
            ]
        },
        "EnergyTankValue": {
            "allOf": [
                {
                    "$ref": "#/definitions/ItemInterface"
                },
                {
                    "type": "object",
                    "properties": {
                        "capacity": {
                            "type": "number",
                            "minimum": 1,
                            "description": "容量"
                        },
                        "accumulate": {
                            "type": "number",
                            "minimum": 1,
                            "description": "回復量"
                        },
                        "requires": {
                            "type": "object",
                            "patternProperties": {
                                "(HAC|STR|DEX|INT|CHA)": {
                                    "type": "number",
                                    "minimum": 1,
                                    "description": "必要量"
                                }
                            },
                            "additionalProperties": false,
                            "uniqueItems": true
                        }
                    },
                    "required": [
                        "capacity",
                        "accumulate"
                    ]
                }
            ]
        },
        "ConsumableValue": {
            "allOf": [
                {
                    "$ref": "#/definitions/ItemInterface"
                },
                {
                    "type": "object",
                    "properties": {
                        "effects": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "description": "効果"
                            },
                            "minItems": 1
                        }
                    },
                    "required": [
                        "effects"
                    ]
                }
            ]
        },
        "SkillValue": {
            "type": "object",
            "properties": {
                "explanation": {
                    "type": "string",
                    "description": "説明"
                },
                "requires": {
                    "type": "object",
                    "properties": {
                        "statuses": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "description": "ステータス",
                                "enum": [
                                    "HAC",
                                    "STR",
                                    "DEX",
                                    "INT",
                                    "CHA",
                                    "LUK"
                                ]
                            },
                            "minItems": 1
                        },
                        "total_value": {
                            "type": "number",
                            "minimum": 1,
                            "description": "基礎必要量"
                        }
                    },
                    "required": [
                        "statuses",
                        "total_value"
                    ],
                    "additionalProperties": false,
                    "uniqueItems": true
                }
            },
            "required": [
                "explanation",
                "requires"
            ]
        },
        "EnemyValue": {
            "type": "object",
            "properties": {
                "hp": {
                    "oneOf": [
                        {
                            "type": "number",
                            "minimum": 1,
                            "description": "HP"
                        },
                        {
                            "type": "string",
                            "const": "Infinity",
                            "description": "HP"
                        }
                    ]
                },
                "atk": {
                    "type": "number",
                    "minimum": 0,
                    "description": "攻撃力"
                },
                "dr": {
                    "type": "number",
                    "minimum": 0,
                    "description": "防御力"
                },
                "hit": {
                    "type": "number",
                    "minimum": 0,
                    "description": "命中率"
                },
                "avd": {
                    "type": "number",
                    "minimum": 0,
                    "description": "回避率"
                },
                "ports": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "description": "能力",
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "名前"
                            },
                            "effect": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "description": "効果"
                                },
                                "minItems": 1
                            }
                        },
                        "required": [
                            "name",
                            "effect"
                        ]
                    }
                },
                "abilities": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "description": "能力",
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "名前"
                            },
                            "effect": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "description": "効果"
                                },
                                "minItems": 1
                            }
                        },
                        "required": [
                            "name",
                            "effect"
                        ]
                    }
                }
            },
            "required": [
                "hp",
                "atk",
                "dr",
                "hit",
                "avd"
            ],
            "additionalProperties": false
        }
    }
}