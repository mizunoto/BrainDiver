{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "title": "隔絶輪廻のブレインダイバーのチャンクスキーマ",
    "version": "2.0.0",
    "id": "chunk.schema.json",
    "default": "chunk.schema.json",
    "description": "隔絶輪廻のブレインダイバーのチャンクスキーマ",
    "properties": {
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "priority": {
            "type": "number"
        },
        "genre": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "include": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "params": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/paramItem"
            }
        }
    },
    "required": [
        "name",
        "priority",
        "genre",
        "params"
    ],
    "definitions": {
        "paramItem": {
            "type": "object",
            "properties": {
                "access_level": {
                    "type": "number"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "flavor",
                        "system",
                        "rule",
                        "description",
                        "glossary",
                        "melee",
                        "ranged",
                        "armor",
                        "energy_tank",
                        "consumable",
                        "template",
                        "ability",
                        "skill",
                        "guideline",
                        "scenario"
                    ]
                }
            },
            "required": [
                "access_level",
                "type",
                "value"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "melee"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/meleeValue"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "ranged"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/rangedValue"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "armor"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/armorValue"
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "energy_tank"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/energy_tankValue"
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "consumable"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/consumableValue"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "skill"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/skillValue"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "system"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "string"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "rule"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/ruleValue"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "description"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "string"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "flavor"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "string"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "glossary"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "string"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "guideline"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "string"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "scenario"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "$ref": "#/definitions/scenarioValue"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "template"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "object"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "ability"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "value": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/abilityValue"
                                }
                            }
                        }
                    }
                }
            ]
        },
        "ruleValue": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/definitions/id"
                },
                "name": {
                    "$ref": "#/definitions/name"
                },
                "explanation": {
                    "type": "string"
                },
                "sub_rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/subRuleValue"
                    }
                }
            },
            "required": [
                "id",
                "name",
                "explanation"
            ]
        },
        "subRuleValue": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/definitions/id"
                },
                "name": {
                    "$ref": "#/definitions/name"
                },
                "explanation": {
                    "type": "string"
                }
            },
            "required": [
                "explanation"
            ]
        },
        "meleeValue": {
            "type": "object",
            "description": "近接武器",
            "properties": {
                "id": {
                    "$ref": "#/definitions/id"
                },
                "name": {
                    "$ref": "#/definitions/name"
                },
                "ATK": {
                    "type": "number",
                    "description": "攻撃判定が成功した際に発生するダメージの基礎の値"
                },
                "HIT": {
                    "type": "number",
                    "description": "攻撃判定の補正値に合算する値"
                },
                "weight": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "light",
                            "standard",
                            "heavy"
                        ],
                        "description": "武器の分類"
                    }
                },
                "features": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "武器特性"
                }
            },
            "required": [
                "id",
                "name",
                "ATK",
                "HIT",
                "weight"
            ]
        },
        "rangedValue": {
            "type": "object",
            "description": "遠距離武器",
            "properties": {
                "id": {
                    "$ref": "#/definitions/id"
                },
                "name": {
                    "$ref": "#/definitions/name"
                },
                "ATK": {
                    "type": "number",
                    "description": "攻撃判定が成功した際に発生するダメージの基礎の値"
                },
                "HIT": {
                    "type": "number",
                    "description": "攻撃判定の補正値に合算する値"
                },
                "weight": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "light",
                            "standard",
                            "heavy"
                        ]
                    },
                    "description": "武器の分類"
                },
                "features": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "武器に付与される特性"
                }
            },
            "required": [
                "id",
                "name",
                "ATK",
                "HIT",
                "weight"
            ]
        },
        "armorValue": {
            "type": "object",
            "description": "防具",
            "properties": {
                "id": {
                    "$ref": "#/definitions/id"
                },
                "name": {
                    "$ref": "#/definitions/name"
                },
                "DR": {
                    "type": "number",
                    "description": "防御力。Damage Reduction"
                },
                "features": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "防具特性"
                }
            },
            "required": [
                "id",
                "name",
                "DR"
            ]
        },
        "energy_tankValue": {
            "type": "object",
            "description": "エネルギータンク",
            "properties": {
                "id": {
                    "$ref": "#/definitions/id"
                },
                "name": {
                    "$ref": "#/definitions/name"
                },
                "max_energy": {
                    "type": "number",
                    "description": "最大エネルギー"
                },
                "regenerate": {
                    "type": "number",
                    "description": "エネルギー回復量"
                },
                "features": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "エネルギータンク特性"
                }
            },
            "required": [
                "id",
                "name",
                "max_energy",
                "regenerate"
            ]
        },
        "consumableValue": {
            "type": "object",
            "description": "消費アイテム",
            "properties": {
                "id": {
                    "$ref": "#/definitions/id"
                },
                "name": {
                    "$ref": "#/definitions/name"
                },
                "effect": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "効果"
                },
                "worth": {
                    "type": "number",
                    "description": "価値"
                },
                "flavor": {
                    "type": "string",
                    "description": "アイテムの説明"
                }
            },
            "required": [
                "id",
                "name",
                "effect",
                "worth"
            ]
        },
        "skillValue": {
            "type": "object",
            "description": "スキル",
            "properties": {
                "id": {
                    "$ref": "#/definitions/id"
                },
                "name": {
                    "$ref": "#/definitions/name"
                },
                "cost": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "STR",
                            "DEX",
                            "CON",
                            "INT",
                            "WIS",
                            "CHA",
                            "LUK"
                        ]
                    },
                    "description": "習得に必要な基礎ステータス"
                },
                "judge_example": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "判定例"
                }
            },
            "required": [
                "id",
                "name",
                "cost",
                "judge_example"
            ]
        },
        "abilityValue": {
            "type": "object",
            "description": "敵に付与される特殊能力",
            "properties": {
                "id": {
                    "$ref": "#/definitions/id"
                },
                "name": {
                    "$ref": "#/definitions/name"
                },
                "effect": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "効果"
                }
            },
            "required": [
                "id",
                "name",
                "effect"
            ]
        },
        "scenarioValue": {
            "type": "object",
            "description": "シナリオ",
            "properties": {
                "id": {
                    "$ref": "#/definitions/id"
                },
                "name": {
                    "$ref": "#/definitions/name"
                },
                "author": {
                    "type": "string"
                },
                "recommended_level": {
                    "type": "string",
                    "enum": [
                        "★☆☆☆☆",
                        "★★☆☆☆",
                        "★★★☆☆",
                        "★★★★☆",
                        "★★★★★"
                    ],
                    "description": "推奨レベル"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "タグ"
                },
                "rewards": {
                    "type": "object",
                    "properties": {
                        "currency": {
                            "type": "string",
                            "pattern": "^\\d+-\\d+$",
                            "description": "獲得できるℂの範囲"
                        },
                        "data_cores": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "enum": [
                                    "データコア-HP",
                                    "データコア-HAC",
                                    "データコア-STR",
                                    "データコア-DEX",
                                    "データコア-INT",
                                    "データコア-CHA",
                                    "データコア-LUK",
                                    "データコア-ALL"
                                ],
                                "description": "獲得できるデータコア"
                            },
                            "description": "獲得の可能性のあるデータコア"
                        },
                        "unique_items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "$ref": "#/definitions/id"
                                },
                                "name": {
                                    "$ref": "#/definitions/name"
                                }
                            },
                            "required": [
                                "id",
                                "name"
                            ]
                        }
                    },
                    "description": "報酬",
                    "required": [
                        "currency"
                    ]
                },
                "actors": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "$ref": "#/definitions/id"
                            },
                            "name": {
                                "$ref": "#/definitions/name"
                            },
                            "archetype": {
                                "type": "string",
                                "description": "基礎モデル"
                            },
                            "ability": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/abilityValue"
                                },
                                "description": "特殊能力"
                            },
                            "remarks": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "備考"
                            }
                        },
                        "required": [
                            "id",
                            "name",
                            "archetype"
                        ]
                    },
                    "description": "シナリオNPC"
                },
                "location": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "$ref": "#/definitions/id"
                            },
                            "name": {
                                "$ref": "#/definitions/name"
                            },
                            "is_alive": {
                                "type": "boolean",
                                "description": "旧時代の施設が生きているか(レリックハックに影響する)"
                            },
                            "remarks": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "備考"
                            }
                        },
                        "required": [
                            "id",
                            "name",
                            "is_alive"
                        ]
                    },
                    "description": "舞台となる場所"
                },
                "key_scenes": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "$ref": "#/definitions/id"
                        },
                        "name": {
                            "$ref": "#/definitions/name"
                        },
                        "trigger": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "description": "トリガーの種類"
                                },
                                "id": {
                                    "type": "string",
                                    "pattern": "^[a-z0-9_]+$",
                                    "description": "トリガーの対象"
                                }
                            },
                            "required": [
                                "id",
                                "type"
                            ]
                        },
                        "situation": {
                            "type": "string",
                            "description": "シーンの説明"
                        },
                        "event": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "combat"
                                    ],
                                    "description": "イベントの種類"
                                }
                            },
                            "allOf": [
                                {
                                    "if": {
                                        "properties": {
                                            "type": {
                                                "const": "combat"
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "value": {
                                                "$ref": "#/definitions/event/combatValue"
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "on_complete": {
                            "type": "object",
                            "properties": {
                                "result": {
                                    "type": "string",
                                    "description": "シーン終了時の結果"
                                },
                                "goto": {
                                    "type": "string",
                                    "description": "イベント成功時の次の処理"
                                }
                            },
                            "required": [
                                "result",
                                "goto"
                            ]
                        }
                    },
                    "description": "シナリオの鍵となるシーン",
                    "required": [
                        "id",
                        "name"
                    ]
                },
                "introduction": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "シナリオの導入"
                },
                "main_stage": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "シナリオの主要な舞台"
                },
                "supposition": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "想定された進行方法"
                }
            },
            "required": [
                "id",
                "name",
                "introduction",
                "main_stage",
                "supposition"
            ]
        },
        "event": {
            "combatValue": {
                "type": "object",
                "description": "戦闘イベント",
                "properties": {
                    "encounter": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "description": "出現する敵のID"
                        },
                        "minItems": 1,
                        "description": "出現する敵"
                    },
                    "rules": {
                        "type": "object",
                        "properties": {
                            "condition": {
                                "type": "string",
                                "description": "条件"
                            },
                            "judge_id": {
                                "type": "string",
                                "description": "判定方法"
                            },
                            "difficulty": {
                                "type": "string",
                                "enum": [
                                    "容易",
                                    "普通",
                                    "困難",
                                    "非常に困難",
                                    "ほぼ不可能",
                                    "無理"
                                ],
                                "description": "難易度"
                            },
                            "on_success": {
                                "type": "string",
                                "description": "成功時の結果"
                            },
                            "on_failure": {
                                "type": "string",
                                "description": "失敗時の結果"
                            },
                            "on_critical": {
                                "type": "string",
                                "description": "クリティカル時の結果"
                            },
                            "on_fumble": {
                                "type": "string",
                                "description": "ファンブル時の結果"
                            }
                        },
                        "description": "特殊ルール",
                        "required": [
                            "condition",
                            "judge_id",
                            "difficulty",
                            "on_success",
                            "on_failure"
                        ]
                    }
                },
                "required": [
                    "encounter"
                ]
            }
        },
        "id": {
            "type": "string",
            "description": "一意のID",
            "pattern": "^[a-z0-9_]+$"
        },
        "name": {
            "type": "string",
            "description": "一意の名前"
        }
    }
}